# Supabase — creer un projet sur https://supabase.com puis copier ces valeurs
# (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (VAPID) — generer avec: npm run generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Secret partage pour autoriser l'appel du endpoint cron de recurrences
CRON_SECRET=change-me

# Cle optionnelle pour un service de taux de change (sinon saisie manuelle)
EXCHANGE_RATE_API_KEY=
